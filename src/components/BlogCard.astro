---
interface Props {
  title: string;
  description: string;
  category: string;
  href: string;
}

const { title, description, category, href } = Astro.props;
---

<article class="blog-card">
  <p class="eyebrow">{category}</p>
  <h3><a href={href}>{title}</a></h3>
  <p>{description}</p>
  <a class="text-link" href={href}>Read article <span aria-hidden="true">→</span></a>
</article>
