---
import BaseLayout from "../layouts/BaseLayout.astro";
import BlogCard from "../components/BlogCard.astro";
import PricingItem from "../components/PricingItem.astro";
import PreviousWorkCarousel from "../components/PreviousWorkCarousel.astro";
import ServiceCard from "../components/ServiceCard.astro";
import { blogPosts } from "../data/blogPosts";

const title = "West O Sharpening | Professional Knife Sharpening";
const description =
  "Professional knife, scissor, and lawn-tool sharpening with convenient pickup, delivery, and drop-off service.";
const assetBase = import.meta.env.BASE_URL;

const workItems = [
  {
    title: "Shear tip repair",
    description: "A damaged point and worn edge reshaped and sharpened for a clean, useful cutting edge.",
    photos: [
      {
        image: `${assetBase}images/previous-work/work-img-2426.jpg`,
        alt: "Damaged shear tip and worn cutting edge before repair",
        label: "Before",
      },
      {
        image: `${assetBase}images/previous-work/work-img-2432.jpg`,
        alt: "Repaired shear tip with a newly sharpened cutting edge",
        label: "After",
      },
    ],
  },
  {
    title: "Pocket knife restoration",
    description: "A three-blade pocket knife cleaned, restored, and sharpened, shown before and from two finished angles.",
    photos: [
      {
        image: `${assetBase}images/previous-work/work-img-3288.jpg`,
        alt: "Three-blade pocket knife with tarnished blades before restoration",
        label: "Before",
      },
      {
        image: `${assetBase}images/previous-work/work-img-3916.jpg`,
        alt: "Restored pocket knife with the polished main blade open",
        label: "After — main blade",
      },
      {
        image: `${assetBase}images/previous-work/work-img-3919.jpg`,
        alt: "Restored pocket knife with a polished detail blade open",
        label: "After — detail blade",
      },
    ],
  },
];
---

<BaseLayout title={title} description={description}>
  <main id="main-content">
    <section class="home-hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">Precision edges. Personal service.</p>
          <h1>Make every cut feel right again.</h1>
          <p>
            Professional sharpening for kitchen knives, pocket knives, scissors, and lawn tools—backed by more than 15 years of hands-on experience.
          </p>
          <div class="hero-actions">
            <a class="button-link" href="#pricing">View pricing</a>
            <a class="button-link button-secondary" href="tel:+16057607918">Call or text</a>
          </div>
        </div>
        <aside class="hero-panel" aria-label="Service highlights">
          <p class="hero-panel-label">Most orders</p>
          <p class="hero-panel-value">Next-day turnaround</p>
          <ul>
            <li>Pickup and delivery available</li>
            <li>Convenient drop-off service</li>
            <li>Tip repairs included</li>
          </ul>
        </aside>
      </div>
    </section>

    <div class="container page-sections">
      <section class="content-section" aria-labelledby="services-title">
        <p class="eyebrow">Simple and convenient</p>
        <h2 class="section-title" id="services-title">Sharpening that fits your schedule</h2>
        <div class="services-grid">
          <ServiceCard icon="🚚" title="Pick-up & Delivery">
            <p>We retrieve and return your knives to your doorstep for maximum convenience.</p>
            <p class="service-note">A one-time $5 pickup and delivery fee applies.</p>
          </ServiceCard>
          <ServiceCard icon="📍" title="Drop-off Service">
            <p>You drop your knives off and pick them up once they’re ready—simple and efficient.</p>
          </ServiceCard>
        </div>
      </section>

      <section class="content-section" id="pricing" aria-labelledby="pricing-title">
        <p class="eyebrow">Clear, straightforward rates</p>
        <h2 class="section-title" id="pricing-title">Standard Sharpening Prices</h2>
        <div class="pricing-grid">
          <PricingItem name="Kitchen Knives" price="$8" />
          <PricingItem name="Pocket/EDC Knives" price="$15" />
          <PricingItem
            name="Scissors/Shears"
            price="$8"
            note="Household, craft, fabric, pinking, and similar shears. No salon shears at this time."
          />
          <PricingItem
            name="Lawn Tools"
            price="$10+"
            note="Mower blades, pruners, loppers, hedge trimmers, and more."
          />
        </div>
        <p class="tip-repair"><span aria-hidden="true">✨</span> Tip repairs are included!</p>
      </section>

      <PreviousWorkCarousel items={workItems} />

      <section class="content-section" aria-labelledby="accounts-title">
        <p class="eyebrow">More ways to sharpen</p>
        <h2 class="section-title" id="accounts-title">Events & Commercial Accounts</h2>
        <div class="services-grid">
          <ServiceCard icon="🛒" title="Sharpen While You Shop Events">
            <p>Want to host a sharpening event at your store, market, or community space? Give us a call and let’s set something up!</p>
          </ServiceCard>
          <ServiceCard icon="🏢" title="Commercial Sharpening">
            <p>Need sharpening for your business one time or on a regular schedule? Call and ask about commercial account options and discounts.</p>
          </ServiceCard>
        </div>
      </section>

      <section class="content-section" aria-labelledby="methods-title">
        <p class="eyebrow">The right method for the tool</p>
        <h2 class="section-title" id="methods-title">Sharpening Methods</h2>
        <article class="method-details">
          <h3><span aria-hidden="true">🔪</span> Kitchen Knives</h3>
          <p>Sharpened on belt sanders by default. Stone sharpening is available upon request for an additional fee.</p>
        </article>
        <article class="method-details">
          <h3><span aria-hidden="true">🗡️</span> EDC/Pocket Knives</h3>
          <p>Done on stones and fixed-angle sharpeners. These knives receive a full cleaning and, for folding knives, pivot lubrication.</p>
        </article>
        <p class="special-request">If you have a specific request for your knives, please let me know. I am more than happy to accommodate.</p>
      </section>

      <section class="content-section" aria-labelledby="blog-title">
        <div class="section-heading-row">
          <div>
            <p class="eyebrow">From the workbench</p>
            <h2 class="section-title" id="blog-title">Knife care and safety</h2>
          </div>
          <a class="text-link" href={`${assetBase}blog/`}>View all articles <span aria-hidden="true">→</span></a>
        </div>
        <div class="blog-grid">
          {blogPosts.map((post) => (
            <BlogCard
              title={post.title}
              description={post.description}
              category={post.category}
              href={`${assetBase}blog/${post.slug}/`}
            />
          ))}
        </div>
      </section>

      <section class="contact-section" id="contact" aria-labelledby="contact-title">
        <p class="eyebrow eyebrow-light">Ready for a better edge?</p>
        <h2 id="contact-title">Get your tools sharpened</h2>
        <div class="contact-grid">
          <article class="contact-method">
            <h3><span aria-hidden="true">📞</span> Call or Text</h3>
            <a href="tel:+16057607918">605-760-7918</a>
          </article>
          <article class="contact-method">
            <h3><span aria-hidden="true">📧</span> Email</h3>
            <a href="mailto:michael@westosharpening.com">michael@westosharpening.com</a>
          </article>
          <article class="contact-method">
            <h3><span aria-hidden="true">📘</span> Facebook</h3>
            <a href="https://facebook.com/westosharpening" target="_blank" rel="noreferrer">facebook.com/westosharpening</a>
          </article>
        </div>
        <ul class="payment-methods" aria-label="Accepted payment methods">
          <li>💵 Cash</li>
          <li>📱 Venmo</li>
          <li>💳 PayPal</li>
        </ul>
      </section>
    </div>
  </main>
</BaseLayout>
